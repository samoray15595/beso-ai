rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 256 &&
             data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']) &&
                      incoming().uid == userId;
    }

    function isValidVideo(data) {
      return data.keys().hasAll(['userId', 'prompt', 'videoUrl', 'status', 'duration', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.prompt is string && data.prompt.size() <= 3000 &&
             data.videoUrl is string && data.videoUrl.size() <= 1000 &&
             data.status in ['draft', 'published'] &&
             data.duration is number && data.duration >= 10 && data.duration <= 60 &&
             data.createdAt == request.time;
    }

    match /videos/{videoId} {
      allow get: if isSignedIn() && (existing().status == 'published' || isOwner(existing().userId));
      allow list: if isSignedIn() && (resource.data.status == 'published' || isOwner(resource.data.userId));
      allow create: if isSignedIn() && isValidVideo(incoming()) && isValidId(videoId);
      allow update: if isOwner(existing().userId) && 
                      isValidVideo(incoming()) &&
                      incoming().userId == existing().userId &&
                      (
                        (incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
                        (incoming().diff(existing()).affectedKeys().hasOnly(['prompt', 'status']))
                      );
      allow delete: if isOwner(existing().userId);
    }

    function isValidCharacter(data) {
      return data.keys().hasAll(['userId', 'imageUrl', 'voiceId', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             data.voiceId is string && data.voiceId.size() <= 64 &&
             data.createdAt == request.time;
    }

    match /characters/{characterId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidCharacter(incoming()) && isValidId(characterId);
      allow delete: if isOwner(existing().userId);
    }
  }
}
